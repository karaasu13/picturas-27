# Copy to .env and edit to override the defaults in docker-compose.yaml.
# .env is git-ignored: keep real credentials there, never in the compose file.
# Every variable below has a working default, so the stack runs without a .env.

# --- Object storage (SeaweedFS S3) ---
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_KEK_PASSPHRASE=picturas-kek-passphrase-change-me

# --- Video services: replicas per kind of work ---
# Replicas of a service consume the same queue, so they process videos in parallel.
VIDEO_EDIT_REPLICAS=4
# More than one subtitles replica: let the first run finish downloading the
# speech model into the shared volume before scaling up.
VIDEO_SUBTITLES_REPLICAS=1
VIDEO_EXTRACT_REPLICAS=1
# Relative CPU weight of the subtitles service under contention (default weight is 1024)
VIDEO_SUBTITLES_CPU_SHARES=512
